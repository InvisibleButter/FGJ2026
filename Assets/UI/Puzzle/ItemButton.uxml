<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Button name="itemButton" class="item-button">
        <ui:Label name="itemCount" text="1" class="item-button__count" picking-mode="Ignore" />
        <ui:VisualElement name="icon" class="item-icon" picking-mode="Ignore" />
        <ui:Label name="itemLabel" class="item-button__label" picking-mode="Ignore" />
    </ui:Button>
</ui:UXML>
