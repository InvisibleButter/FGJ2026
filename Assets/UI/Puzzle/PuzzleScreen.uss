.puzzle-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Top bar */

.top-bar {
    flex-direction: row;
    align-items: center;
    height: 120px;
    padding: 0 40px;
}

.title-block {
    width: 460px;
}

.puzzle-number {
    font-size: 22px;
    color: var(--color-text-dim);
}

.puzzle-name {
    font-size: 40px;
}

.calendar {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.calendar__label {
    margin-right: 10px;
    font-size: 26px;
    color: var(--color-text-dim);
}

.day-list {
    flex-direction: row;
}

.day {
    width: 72px;
    height: 72px;
    margin-right: 10px;
    background-image: url("project://database/Assets/Art/ui.png?fileID=-9005941153719796207&guid=e8afd4c812d601c478793753c404b6ba&type=3#Puzzle");
    -unity-slice-scale: 4px;
    transition-duration: 0.3s;
}

.day__label {
    flex-grow: 1;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.day--past {
    opacity: 0.55;
}

.day--past > .day__label {
    color: var(--color-text-dim);
}

.day--current {
    background-image: url("project://database/Assets/Art/ui.png?fileID=-9080700020481880845&guid=e8afd4c812d601c478793753c404b6ba&type=3#Puzzle_highlighted");
}

.clock {
    flex-direction: row;
    align-items: center;
    width: 380px;
}

/* Pocket watch: white, pink when the day gets late, red for the last ticks */
.clock__tick {
    width: 105px;
    height: 114px;
    margin-right: 14px;
    padding-top: 14px;
    background-image: url("project://database/Assets/Art/ui.png?fileID=4874896633046561287&guid=e8afd4c812d601c478793753c404b6ba&type=3#Ticks_Background");
    -unity-background-scale-mode: scale-to-fit;
    color: var(--color-text-dark);
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.clock__tick--late {
    background-image: url("project://database/Assets/Art/ui.png?fileID=-7334886338573059942&guid=e8afd4c812d601c478793753c404b6ba&type=3#Ticks_Background_22");
}

.clock__tick--last {
    background-image: url("project://database/Assets/Art/ui.png?fileID=3793417686556777753&guid=e8afd4c812d601c478793753c404b6ba&type=3#Ticks_Background_23");
    color: var(--color-text);
}

.clock__info {
    flex-grow: 1;
}

.clock__caption {
    font-size: 20px;
}

.clock__bar {
    margin: 6px 0 0 0;
}

.clock__bar .unity-progress-bar__background {
    height: 10px;
    background-color: var(--color-panel);
    border-width: 0;
    border-radius: 5px;
}

.clock__bar .unity-progress-bar__progress {
    background-color: var(--color-accent);
    border-radius: 5px;
}

.clock__bar .unity-progress-bar__title-container {
    display: none;
}

.top-buttons {
    flex-direction: row;
}

.top-button {
    height: 66px;
    margin-left: 14px;
}

/* Exit is the little door */
.exit-button,
.exit-button:hover {
    width: 68px;
    height: 84px;
    padding: 0;
    background-image: url("project://database/Assets/Art/ui.png?fileID=1712464482933603101&guid=e8afd4c812d601c478793753c404b6ba&type=3#Exit");
    -unity-background-scale-mode: scale-to-fit;
}

.exit-button:hover {
    -unity-background-image-tint-color: #D8D0C8;
}

/* Middle: behaviour lists left and right, the board (drawn by the camera) in between */

.middle {
    flex-direction: row;
    flex-grow: 1;
    padding: 10px 30px;
}

.behaviour-column {
    width: 420px;
}

.board-area {
    flex-grow: 1;
    margin: 0 20px;
}

.behaviour-panel {
    margin-bottom: 16px;
}

.behaviour-panel__header {
    flex-direction: row;
    align-items: center;
    height: 40px;
}

.behaviour-panel__name {
    margin-left: 12px;
    font-size: 30px;
    -unity-font-style: bold;
}

.behaviour-panel__status {
    margin: 4px 0 8px 0;
    font-size: 20px;
    color: var(--color-text-dim);
}

.behaviour-panel__empty {
    font-size: 22px;
    color: var(--color-text-dim);
    -unity-font-style: italic;
}

.behaviour-block {
    min-height: 52px;
    margin-top: 6px;
    padding: 10px 16px;
    justify-content: center;
    background-color: #284848;
    transition-duration: 0.5s;
}

.behaviour-block__text {
    font-size: 24px;
    white-space: normal;
}

.behaviour-block--pending {
    opacity: 0.5;
}

.behaviour-block--active {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/ui.png?fileID=-9080700020481880845&guid=e8afd4c812d601c478793753c404b6ba&type=3#Puzzle_highlighted");
    -unity-slice-scale: 4px;
    transition-duration: 0s;
}

.behaviour-block--learned {
    background-color: #B89848;
    opacity: 1;
    transition-duration: 0s;
}

/* Bottom bar */

.bottom-bar {
    flex-direction: row;
    align-items: center;
    height: 160px;
    padding: 0 40px;
    background-color: var(--color-panel);
    border-top-width: 6px;
    border-color: var(--color-accent);
}

.item-bag {
    flex-direction: row;
    align-items: center;
    width: 660px;
}

/* The backpack, then a brown pocket holding the items */
.item-bag__icon {
    width: 99px;
    height: 102px;
    margin-right: 10px;
    background-image: url("project://database/Assets/Art/ui.png?fileID=2697481083480110284&guid=e8afd4c812d601c478793753c404b6ba&type=3#Backpack");
    -unity-background-scale-mode: scale-to-fit;
}

.item-bag__pocket {
    flex-direction: row;
    align-items: center;
    min-height: 120px;
    padding: 10px 14px;
    background-image: url("project://database/Assets/Art/ui.png?fileID=-7787622976490332879&guid=e8afd4c812d601c478793753c404b6ba&type=3#Backpack_Background");
    -unity-slice-scale: 6px;
}

.item-list {
    flex-direction: row;
}

.item-button,
.item-button:hover {
    background-image: none;
}

.item-button {
    flex-direction: row;
    align-items: center;
    width: 240px;
    height: 100px;
    margin: 0 4px;
    padding: 8px 18px;
}

.item-button:hover {
    background-color: rgba(56, 24, 40, 0.15);
}

/* The picked item gets the dashed frame */
.item-button--selected,
.item-button--selected:hover {
    background-image: url("project://database/Assets/Art/ui.png?fileID=8950759142192175709&guid=e8afd4c812d601c478793753c404b6ba&type=3#Backpack_Itemframe");
    -unity-slice-scale: 6px;
}

.item-button > .item-icon {
    margin-right: 14px;
}

.item-button__label {
    flex-grow: 1;
    font-size: 24px;
    color: var(--color-text-dark);
    -unity-text-align: middle-left;
    white-space: normal;
}

.status {
    flex-grow: 1;
    margin: 0 30px;
}

.phase-label {
    font-size: 24px;
    color: var(--color-accent);
}

.message-label {
    font-size: 22px;
    white-space: normal;
}

.actions {
    flex-direction: row;
}

.action-button {
    height: 92px;
    margin-left: 14px;
    font-size: 34px;
}

.start-button {
    width: 210px;
}

.skip-button {
    width: 180px;
}

.phase-banner {
    position: absolute;
    top: 120px;
    left: 0;
    right: 0;
    overflow: hidden;
}

.phase-banner__track {
    flex-direction: row;
    justify-content: center;
    translate: -100% 0;
}

.phase-banner__track--centered {
    translate: 0% 0;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

.phase-banner__track--exiting {
    translate: 100% 0;
    transition-duration: 0.35s;
    transition-timing-function: ease-in;
}

.phase-banner__label {
    margin: 0;
    padding: 18px 50px;
    background-image: url("project://database/Assets/Art/ui.png?fileID=2163036573998151787&guid=e8afd4c812d601c478793753c404b6ba&type=3#Start_UI_Titlebanner");
    -unity-slice-scale: 6px;
    color: var(--color-text-dark);
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Result window */

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.65);
}

.result-card {
    width: 900px;
}

.result-title {
    font-size: 58px;
    color: var(--color-accent);
    -unity-text-align: middle-center;
}

.result-subtitle {
    margin-bottom: 14px;
    color: var(--color-text-dim);
    -unity-text-align: middle-center;
}

.result-card .star-row {
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.result-card .star-row > .star {
    scale: 1 1;
    transition-duration: 0.26s;
    transition-timing-function: ease-out-back;
}

.result-star--pending .star-row {
    opacity: 0;
    transition-duration: 0s;
}

.result-star--pending .star-row > .star {
    scale: 0.3 0.3;
    transition-duration: 0s;
}

.result-buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 20px;
}

.result-button {
    height: 72px;
    margin: 0 8px;
}
