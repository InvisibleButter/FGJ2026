.puzzle-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Top bar */

.top-bar {
    flex-direction: row;
    align-items: center;
    height: 138px;
    padding: 0 40px;
}

.title-block {
    width: 460px;
}

.puzzle-number {
    font-size: 22px;
    color: var(--color-text-dim);
}

.puzzle-name {
    font-size: 40px;
}

.calendar {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.calendar__label {
    margin-left: 12px;
    font-size: 26px;
    color: var(--color-text-dim);
}

/* Tear-off calendar: 28x22 art pixels at 6x; the frames are placed by CalendarView.cs */
.calendar-view {
    width: 168px;
    height: 132px;
    margin-top: 42px; /* page level with the clock; the ripped page falls below the bar */
    overflow: hidden;
}

.calendar-view__frame {
    position: absolute;
}

/* The writable part of the page */
.calendar-view__day {
    position: absolute;
    left: 84px;
    top: 12px;
    width: 72px;
    height: 72px;
    color: var(--color-text-dark);
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.clock {
    flex-direction: row;
    align-items: center;
    width: 330px;
}

/* Pocket watch: the hand goes round once per day. White, pink when the day gets late, red for the last ticks. */
.clock__face {
    width: 105px;
    height: 114px;
    margin-right: 14px;
    background-image: url("project://database/Assets/Art/ui.png?fileID=4874896633046561287&guid=e8afd4c812d601c478793753c404b6ba&type=3#Ticks_Background");
    -unity-background-scale-mode: scale-to-fit;
}

.clock__face--late {
    background-image: url("project://database/Assets/Art/ui.png?fileID=-7334886338573059942&guid=e8afd4c812d601c478793753c404b6ba&type=3#Ticks_Background_22");
}

.clock__face--last {
    background-image: url("project://database/Assets/Art/ui.png?fileID=3793417686556777753&guid=e8afd4c812d601c478793753c404b6ba&type=3#Ticks_Background_23");
}

/* Dial centre: art pixel (17, 20) of the 35x38 sprite, drawn 3x */
.clock__hand {
    position: absolute;
    left: 51px;
    top: 33px;
    width: 3px;
    height: 30px;
    background-color: #483848;
    transform-origin: 50% 100%;
}

.clock__cap {
    position: absolute;
    left: 48px;
    top: 58px;
    width: 9px;
    height: 9px;
    background-color: #483848;
}

.clock__info {
    flex-grow: 1;
}

/* Tick count on the lower half of the dial, in front of the hand */
.clock__tick {
    position: absolute;
    left: 15px;
    right: 15px;
    top: 66px;
    height: 27px;
    color: var(--color-text-dark);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.clock__face--last > .clock__tick {
    color: var(--color-text);
}

.clock__caption {
    font-size: 20px;
    color: var(--color-text-dim);
}

.top-buttons {
    flex-direction: row;
}

.top-button {
    height: 66px;
    margin-left: 14px;
}

/* Exit is the little door */
.exit-button,
.exit-button:hover {
    width: 51px;
    height: 63px;
    padding: 0;
    background-image: url("project://database/Assets/Art/ui.png?fileID=1712464482933603101&guid=e8afd4c812d601c478793753c404b6ba&type=3#Exit");
    -unity-background-scale-mode: scale-to-fit;
}

.exit-button:hover {
    -unity-background-image-tint-color: #D8D0C8;
}

/* Middle: behaviour lists left and right, the board (drawn by the camera) in between */

.middle {
    flex-direction: row;
    flex-grow: 1;
    padding: 10px 30px;
}

.behaviour-column {
    width: 420px;
}

.board-area {
    flex-grow: 1;
    margin: 0 20px;
}

.behaviour-panel {
    margin-bottom: 16px;
}

/* Panel = the animal's [Color]_Background, each behaviour = its [Color]_Element */
.panel.behaviour-panel--red { background-image: url("project://database/Assets/Art/ui.png?fileID=9193187447140095505&guid=e8afd4c812d601c478793753c404b6ba&type=3#Red_Background"); }
.panel.behaviour-panel--blue { background-image: url("project://database/Assets/Art/ui.png?fileID=8825907884645483951&guid=e8afd4c812d601c478793753c404b6ba&type=3#Blue_Background"); }
.panel.behaviour-panel--green { background-image: url("project://database/Assets/Art/ui.png?fileID=8062878643169288418&guid=e8afd4c812d601c478793753c404b6ba&type=3#Green_Background"); }
.panel.behaviour-panel--yellow { background-image: url("project://database/Assets/Art/ui.png?fileID=-4044852013064114820&guid=e8afd4c812d601c478793753c404b6ba&type=3#Yellow_Background"); }
.panel.behaviour-panel--purple { background-image: url("project://database/Assets/Art/ui.png?fileID=-8761496183629611704&guid=e8afd4c812d601c478793753c404b6ba&type=3#Purple_Background"); }
.panel.behaviour-panel--orange { background-image: url("project://database/Assets/Art/ui.png?fileID=-9211019987572867793&guid=e8afd4c812d601c478793753c404b6ba&type=3#Orange_Background"); }
.panel.behaviour-panel--turquoise { background-image: url("project://database/Assets/Art/ui.png?fileID=-3439486116421378984&guid=e8afd4c812d601c478793753c404b6ba&type=3#Turquis_Background"); }

.behaviour-panel__header {
    flex-direction: row;
    align-items: center;
    height: 40px;
}

.behaviour-panel__header > .swatch {
    display: none;
}

.behaviour-panel__name {
    font-size: 30px;
    -unity-font-style: bold;
}

.behaviour-panel__status {
    margin: 2px 0 8px 0;
    font-size: 20px;
    color: var(--color-text-dim);
}

.behaviour-panel__empty {
    font-size: 22px;
    color: var(--color-text-dim);
    -unity-font-style: italic;
}

/* Light colours (green, yellow, orange, blue) get dark text */
.behaviour-panel--light .behaviour-panel__name,
.behaviour-panel--light .behaviour-panel__status,
.behaviour-panel--light .behaviour-panel__empty {
    color: var(--color-text-dark);
}

.behaviour-block {
    min-height: 52px;
    margin-top: 6px;
    padding: 10px 16px;
    justify-content: center;
    border-width: 0;
    border-color: var(--color-text-dark);
    -unity-slice-scale: 6px;
    transition-duration: 0.5s;
}

.behaviour-block--red { background-image: url("project://database/Assets/Art/ui.png?fileID=-3120730603551926074&guid=e8afd4c812d601c478793753c404b6ba&type=3#Red_Element"); }
.behaviour-block--blue { background-image: url("project://database/Assets/Art/ui.png?fileID=-5130057317469923895&guid=e8afd4c812d601c478793753c404b6ba&type=3#Blue_Element"); }
.behaviour-block--green { background-image: url("project://database/Assets/Art/ui.png?fileID=-2699499167317838321&guid=e8afd4c812d601c478793753c404b6ba&type=3#Green_Element"); }
.behaviour-block--yellow { background-image: url("project://database/Assets/Art/ui.png?fileID=6318320377479184414&guid=e8afd4c812d601c478793753c404b6ba&type=3#Yellow_Element"); }
.behaviour-block--purple { background-image: url("project://database/Assets/Art/ui.png?fileID=7285970225754692813&guid=e8afd4c812d601c478793753c404b6ba&type=3#Purple_Element"); }
.behaviour-block--orange { background-image: url("project://database/Assets/Art/ui.png?fileID=621127007532356092&guid=e8afd4c812d601c478793753c404b6ba&type=3#Orange_Element"); }
.behaviour-block--turquoise { background-image: url("project://database/Assets/Art/ui.png?fileID=1113166408476123525&guid=e8afd4c812d601c478793753c404b6ba&type=3#Turquis_Element"); }

.behaviour-block__text {
    font-size: 24px;
    color: var(--color-text-dark);
    white-space: normal;
}

.behaviour-block--pending {
    opacity: 0.5;
}

/* The behaviour in use gets a dark outline for a moment */
.behaviour-block--active {
    border-width: 3px;
    transition-duration: 0s;
}

/* A lesson that starts working today flashes with a gold outline */
.behaviour-block--learned {
    border-width: 6px;
    border-color: var(--color-accent);
    opacity: 1;
    transition-duration: 0s;
}

/* Bottom bar */

.bottom-bar {
    flex-direction: row;
    align-items: center;
    height: 168px;
    padding: 0 40px;
    background-color: var(--color-panel);
    border-top-width: 6px;
    border-color: var(--color-accent);
}

.item-bag {
    flex-direction: row;
    align-items: center;
    width: 660px;
}

/* The backpack, then a brown pocket holding the items */
/* 33x34 at 6x: the sack sits on the bar and sticks out over its top edge */
.item-bag__icon {
    width: 198px;
    height: 204px;
    margin: 0 10px 0 -20px;
    align-self: flex-end;
    background-image: url("project://database/Assets/Art/ui.png?fileID=2697481083480110284&guid=e8afd4c812d601c478793753c404b6ba&type=3#Backpack");
    -unity-background-scale-mode: scale-to-fit;
}

.item-bag__pocket {
    flex-direction: row;
    align-items: center;
    min-height: 132px;
    padding: 10px 14px;
    background-image: url("project://database/Assets/Art/ui.png?fileID=-7787622976490332879&guid=e8afd4c812d601c478793753c404b6ba&type=3#Backpack_Background");
    -unity-slice-scale: 6px;
}

.item-list {
    flex-direction: row;
}

.item-button,
.item-button:hover {
    background-image: none;
}

.item-button {
    flex-direction: row;
    align-items: center;
    height: 120px;
    margin: 0 4px;
    padding: 8px 18px 8px 14px;
}

.item-button:hover {
    background-color: rgba(56, 24, 40, 0.15);
}

/* The picked item gets the dashed frame */
.item-button--selected,
.item-button--selected:hover {
    background-image: url("project://database/Assets/Art/ui.png?fileID=8950759142192175709&guid=e8afd4c812d601c478793753c404b6ba&type=3#Backpack_Itemframe");
    -unity-slice-scale: 6px;
}

.item-button > .item-icon {
    width: 90px;
    height: 96px;
}

.item-button__count {
    margin-right: 8px;
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--color-text-dark);
}

/* The name only shows while hovering, as a little banner above the item */
.item-button__label {
    display: none;
    position: absolute;
    bottom: 112px;
    left: 0;
    padding: 8px 18px;
    background-image: url("project://database/Assets/Art/ui.png?fileID=2163036573998151787&guid=e8afd4c812d601c478793753c404b6ba&type=3#Start_UI_Titlebanner");
    -unity-slice-scale: 3px;
    color: var(--color-text-dark);
    font-size: 22px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.item-button:hover > .item-button__label {
    display: flex;
}

.status {
    flex-grow: 1;
    margin: 0 30px;
}

.phase-label {
    font-size: 24px;
    color: var(--color-accent);
}

.message-label {
    font-size: 22px;
    white-space: normal;
}

.actions {
    flex-direction: row;
}

.action-button {
    height: 92px;
    margin-left: 14px;
    font-size: 34px;
}

.start-button {
    width: 210px;
}

.skip-button {
    width: 180px;
}

.phase-banner {
    position: absolute;
    top: 120px;
    left: 0;
    right: 0;
    overflow: hidden;
}

.phase-banner__track {
    flex-direction: row;
    justify-content: center;
    translate: -100% 0;
}

.phase-banner__track--centered {
    translate: 0% 0;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

.phase-banner__track--exiting {
    translate: 100% 0;
    transition-duration: 0.35s;
    transition-timing-function: ease-in;
}

.phase-banner__label {
    margin: 0;
    padding: 18px 50px;
    background-image: url("project://database/Assets/Art/ui.png?fileID=2163036573998151787&guid=e8afd4c812d601c478793753c404b6ba&type=3#Start_UI_Titlebanner");
    -unity-slice-scale: 6px;
    color: var(--color-text-dark);
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Result window */

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.65);
}

.result-card {
    width: 900px;
}

.result-title {
    font-size: 58px;
    color: var(--color-accent);
    -unity-text-align: middle-center;
}

.result-subtitle {
    margin-bottom: 14px;
    color: var(--color-text-dim);
    -unity-text-align: middle-center;
}

.result-card .star-row {
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.result-card .star-row > .star {
    scale: 1 1;
    transition-duration: 0.26s;
    transition-timing-function: ease-out-back;
}

.result-star--pending .star-row {
    opacity: 0;
    transition-duration: 0s;
}

.result-star--pending .star-row > .star {
    scale: 0.3 0.3;
    transition-duration: 0s;
}

.result-buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 20px;
}

.result-button {
    height: 72px;
    margin: 0 8px;
}
