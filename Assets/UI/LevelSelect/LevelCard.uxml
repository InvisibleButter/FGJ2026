<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Button name="levelCard" class="level-card">
        <ui:VisualElement class="level-card__pad" picking-mode="Ignore">
            <ui:Label name="cardNumber" text="1" class="level-card__number" picking-mode="Ignore" />
            <ui:VisualElement name="cardStars" class="level-card__stars" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Label name="cardName" text="Name" class="level-card__name" picking-mode="Ignore" />
    </ui:Button>
</ui:UXML>
