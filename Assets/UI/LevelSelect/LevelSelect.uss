.level-select {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    padding: 50px 60px;
    background-color: var(--color-bg);
    background-image: url("project://database/Assets/Art/ui.png?fileID=8852797563311604980&guid=e8afd4c812d601c478793753c404b6ba&type=3#Background");
    -unity-slice-scale: 6px;
}

.level-list-side {
    flex-grow: 1;
    margin-right: 40px;
}

.level-header {
    flex-direction: row;
    align-items: center;
    height: 100px;
}

.level-title {
    flex-grow: 1;
    font-size: 64px;
}

.total-stars {
    flex-direction: row;
    align-items: center;
}

.total-stars > .star {
    width: 63px;
    height: 57px;
}

.total-stars__label {
    margin-left: 12px;
    font-size: 40px;
}

.level-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    flex-grow: 1;
    margin-top: 20px;
}

/* Each puzzle is a lily pad on the water; the name sits below it. */
.level-card,
.level-card:hover {
    background-image: none;
}

.level-card {
    width: 216px;
    height: 220px;
    margin: 0 24px 24px 0;
    padding: 0;
    align-items: center;
    justify-content: flex-start;
}

.level-card__pad {
    width: 216px;
    height: 144px;
    padding: 14px 0 18px 30px;
    justify-content: center;
    background-image: url("project://database/Assets/Art/ui.png?fileID=-6774437969098921397&guid=e8afd4c812d601c478793753c404b6ba&type=3#Puzzle_Button");
    -unity-slice-scale: 6px;
}

.level-card:hover > .level-card__pad {
    -unity-background-image-tint-color: #E4ECD8;
}

.level-card--selected > .level-card__pad,
.level-card--selected:hover > .level-card__pad {
    background-image: url("project://database/Assets/Art/ui.png?fileID=-7420991742971661633&guid=e8afd4c812d601c478793753c404b6ba&type=3#Puzzle_Clicked");
    -unity-background-image-tint-color: #FFFFFF;
}

.level-card__number {
    font-size: 52px;
    color: var(--color-text-dark);
    -unity-text-align: middle-center;
}

.level-card--selected .level-card__number {
    color: var(--color-text);
}

.level-card__name {
    margin-top: 8px;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    white-space: normal;
}

.level-card__stars {
    flex-direction: row;
    justify-content: center;
}

.level-card__stars > .star {
    margin: 0 2px;
}

.empty-label {
    font-size: 30px;
    color: var(--color-text-dim);
}

.back-button {
    align-self: flex-start;
    width: 200px;
    height: 72px;
}

.details {
    width: 700px;
}

.details__number {
    font-size: 28px;
    color: var(--color-text-dim);
    -unity-text-align: middle-center;
}

.details__name {
    font-size: 48px;
    -unity-text-align: middle-center;
}

.preview-frame {
    height: 360px;
    margin: 6px 0;
}

.preview {
    flex-grow: 1;
    margin: 24px 22px 34px 22px;
    background-color: var(--color-bg);
}

/* Grassy frame drawn over the preview picture */
.preview__border {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Art/ui.png?fileID=6071220295474305178&guid=e8afd4c812d601c478793753c404b6ba&type=3#Puzzle_Previewborder");
    -unity-slice-scale: 6px;
}

.details__info {
    margin-bottom: 10px;
    font-size: 24px;
    color: var(--color-text-dim);
    -unity-text-align: middle-center;
}

.details__stars {
    flex-grow: 1;
}

.play-button {
    height: 86px;
    font-size: 36px;
}
