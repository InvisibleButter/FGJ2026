:root {
    --color-bg: #486878;
    --color-panel: #582838;
    --color-panel-hover: #683848;
    --color-panel-light: #884848;
    --color-text: #F3E6C8;
    --color-text-dim: #D8C0A0;
    --color-text-dark: #381828;
    --color-accent: #D8B868;
    --color-good: #A8B858;
    --color-bad: #E88858;
    --color-button: #689858;
    --color-button-hover: #78A868;
    --color-button-secondary: #884848;
    --color-button-secondary-hover: #986868;
    --color-button-go: #689858;
    --color-button-go-hover: #78A868;
    --color-star-on: #D8B868;
    --color-star-off: #381828;
    -unity-font: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf");
    color: var(--color-text);
    font-size: 22px;
}

/* Our own theme replaces Unity's default one, so the document root needs this rule to fill the screen. */
.unity-ui-document__root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hidden {
    display: none;
}

/* Art from Assets/Art/ui.png. Sliced sprites use their own borders; -unity-slice-scale 6px = one art pixel is 6 screen pixels at 1080p. */

.panel {
    background-image: url("project://database/Assets/Art/ui.png?fileID=-9005941153719796207&guid=e8afd4c812d601c478793753c404b6ba&type=3#Puzzle");
    -unity-slice-scale: 6px;
    padding: 18px 20px;
}

/* The wooden sign (start menu frame): big windows. The bottom slice holds the little legs. */
.sign {
    background-image: url("project://database/Assets/Art/ui.png?fileID=5707218116961789024&guid=e8afd4c812d601c478793753c404b6ba&type=3#Start_UI_Frame");
    -unity-slice-scale: 6px;
    padding: 42px 48px 78px 48px;
}

.banner {
    background-image: url("project://database/Assets/Art/ui.png?fileID=2163036573998151787&guid=e8afd4c812d601c478793753c404b6ba&type=3#Start_UI_Titlebanner");
    -unity-slice-scale: 6px;
    color: var(--color-text-dark);
}

.text-dim {
    color: var(--color-text-dim);
}

/* Buttons: wooden option bar, darker bar when hovered */

.unity-button {
    background-image: url("project://database/Assets/Art/ui.png?fileID=3556181715638617739&guid=e8afd4c812d601c478793753c404b6ba&type=3#Start_UI_Option");
    -unity-slice-scale: 6px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-text);
    border-width: 0;
    border-radius: 0;
    margin: 0;
    padding: 8px 24px 10px 24px;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.12s;
}

.unity-button:hover {
    background-image: url("project://database/Assets/Art/ui.png?fileID=-8816031292267695619&guid=e8afd4c812d601c478793753c404b6ba&type=3#Start_UI_Option_clicked");
}

.unity-button:active {
    scale: 0.97 0.97;
}

.unity-button:disabled {
    opacity: 0.4;
}

.button--primary,
.button--primary:hover {
    background-image: url("project://database/Assets/Art/ui.png?fileID=-9005941153719796207&guid=e8afd4c812d601c478793753c404b6ba&type=3#Puzzle");
}

.button--primary:hover {
    -unity-background-image-tint-color: #C8D8D0;
}

.button--go,
.button--go:hover {
    background-image: url("project://database/Assets/Art/ui.png?fileID=-9080700020481880845&guid=e8afd4c812d601c478793753c404b6ba&type=3#Puzzle_highlighted");
}

.button--go:hover {
    -unity-background-image-tint-color: #D8E8C8;
}

/* Stars */

.star {
    width: 42px;
    height: 38px;
    background-image: url("project://database/Assets/Art/ui.png?fileID=-7975249404588759376&guid=e8afd4c812d601c478793753c404b6ba&type=3#Empty_Star");
    -unity-background-scale-mode: scale-to-fit;
}

.star--on {
    background-image: url("project://database/Assets/Art/ui.png?fileID=7263181891274304025&guid=e8afd4c812d601c478793753c404b6ba&type=3#Star");
}

.star-row {
    flex-direction: row;
    align-items: center;
    height: 54px;
}

.star-row > .star {
    width: 42px;
    height: 38px;
}

.star-row__text {
    flex-grow: 1;
    margin-left: 16px;
    font-size: 28px;
}

.star-row--off > .star-row__text {
    color: var(--color-text-dim);
}

.star-row__note {
    font-size: 22px;
    color: var(--color-text-dim);
    -unity-text-align: middle-right;
}

/* Animal colours (swatches and markers), from the [Color]_Background swatches in ui.png */

.swatch {
    width: 42px;
    height: 42px;
    background-image: url("project://database/Assets/UI/Shared/Icons/circle.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.color-red { background-image: url("project://database/Assets/Art/ui.png?fileID=9193187447140095505&guid=e8afd4c812d601c478793753c404b6ba&type=3#Red_Background"); }
.color-blue { background-image: url("project://database/Assets/Art/ui.png?fileID=8825907884645483951&guid=e8afd4c812d601c478793753c404b6ba&type=3#Blue_Background"); }
.color-green { background-image: url("project://database/Assets/Art/ui.png?fileID=8062878643169288418&guid=e8afd4c812d601c478793753c404b6ba&type=3#Green_Background"); }
.color-yellow { background-image: url("project://database/Assets/Art/ui.png?fileID=-4044852013064114820&guid=e8afd4c812d601c478793753c404b6ba&type=3#Yellow_Background"); }
.color-purple { background-image: url("project://database/Assets/Art/ui.png?fileID=-8761496183629611704&guid=e8afd4c812d601c478793753c404b6ba&type=3#Purple_Background"); }
.color-orange { background-image: url("project://database/Assets/Art/ui.png?fileID=-9211019987572867793&guid=e8afd4c812d601c478793753c404b6ba&type=3#Orange_Background"); }
.color-turquoise { background-image: url("project://database/Assets/Art/ui.png?fileID=-3439486116421378984&guid=e8afd4c812d601c478793753c404b6ba&type=3#Turquis_Background"); }
/* No art for these yet: tinted circles */
.color-pink { -unity-background-image-tint-color: #F580B8; }
.color-white { -unity-background-image-tint-color: #F2F2F2; }

/* Items */

.item-icon {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
}

.item-icon--good-sweet {
    background-image: url("project://database/Assets/Art/Animations.png?fileID=-1549255267&guid=6b67d35042a9a154e862226cb39d14c9&type=3#Deliciuose_Sweet");
}

.item-icon--bad-sweet {
    background-image: url("project://database/Assets/Art/Animations.png?fileID=-817041578&guid=6b67d35042a9a154e862226cb39d14c9&type=3#Horrible_Sweet");
}
